# Backend que sirve el catálogo público (el mismo de Railway).
# SIN barra final. La app le pega a  <NEXT_PUBLIC_API_URL>/api/publico/catalogo/...
NEXT_PUBLIC_API_URL=https://inventario-final-production.up.railway.app

# Dominio donde se despliega ESTA app. Solo lo usan el sitemap y robots.txt.
NEXT_PUBLIC_SITE_URL=https://midominio.com

# Secreto compartido con el backend para el refresco inmediato.
# El MISMO valor va en Railway como CATALOGO_REVALIDATE_SECRET.
# Sin esto el catálogo funciona igual, pero se refresca solo cada 30 minutos.
# Genéralo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=
