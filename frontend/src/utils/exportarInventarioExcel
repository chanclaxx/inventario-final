import * as XLSX from 'xlsx';

// ─── Paleta de colores ────────────────────────────────────────────────────────
const COLOR = {
  headerSerial:   '1E40AF',
  headerCantidad: '065F46',
  disponible:     'FFFFFF',
  vendido:        'FEE2E2',
  prestado:       'FEF9C3',
  textoHeader:    'FFFFFF',
  resumenBg:      'EFF6FF',
  bordeColor:     'D1D5DB',
};

// ─── Helpers de estilo ────────────────────────────────────────────────────────
function estiloHeader(bgColor) {
  return {
    font:      { bold: true, color: { rgb: COLOR.textoHeader }, name: 'Arial', sz: 10 },
    fill:      { patternType: 'solid', fgColor: { rgb: bgColor } },
    alignment: { horizontal: 'center', vertical: 'center', wrapText: true },
    border:    bordeDelgado(),
  };
}

function bordeDelgado() {
  const lado = { style: 'thin', color: { rgb: COLOR.bordeColor } };
  return { top: lado, bottom: lado, left: lado, right: lado };
}

function estiloCelda(bgColor) {
  return {
    font:      { name: 'Arial', sz: 9 },
    fill:      { patternType: 'solid', fgColor: { rgb: bgColor } },
    alignment: { vertical: 'center' },
    border:    bordeDelgado(),
  };
}

function estiloCeldaHistorial() {
  return {
    font:      { name: 'Arial', sz: 8, italic: true, color: { rgb: '9CA3AF' } },
    fill:      { patternType: 'solid', fgColor: { rgb: 'FEF2F2' } },
    alignment: { vertical: 'center' },
    border:    bordeDelgado(),
  };
}

function estiloCeldaCentrada(bgColor) {
  return {
    ...estiloCelda(bgColor),
    alignment: { horizontal: 'center', vertical: 'center' },
  };
}

function estiloResumen() {
  return {
    font:      { bold: true, name: 'Arial', sz: 9, color: { rgb: '1E3A5F' } },
    fill:      { patternType: 'solid', fgColor: { rgb: COLOR.resumenBg } },
    alignment: { horizontal: 'center', vertical: 'center' },
    border:    bordeDelgado(),
  };
}

// ─── Formatear fecha ──────────────────────────────────────────────────────────
function fmtFecha(val) {
  if (!val) return '';
  // DATE puro "YYYY-MM-DD" → formatear directamente sin pasar por Date (evita salto de día UTC)
  if (typeof val === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(val)) {
    const [y, m, d] = val.split('-');
    return `${d}/${m}/${y}`;
  }
  const d = new Date(val);
  if (isNaN(d)) return '';
  return d.toLocaleDateString('es-CO', {
    timeZone: 'America/Bogota',
    day: '2-digit', month: '2-digit', year: 'numeric',
  });
}

// ─── Hoja de producto serial ──────────────────────────────────────────────────
function crearHojaSerial(nombreProducto, seriales) {
  const ws = {};

  ws['A1'] = {
    t: 's', v: nombreProducto.toUpperCase(),
    s: {
      font:      { bold: true, name: 'Arial', sz: 13, color: { rgb: COLOR.headerSerial } },
      alignment: { horizontal: 'left', vertical: 'center' },
    },
  };

  const disponibles = seriales.filter((s) => !s.vendido && !s.prestado);
  const prestados   = seriales.filter((s) =>  s.prestado && !s.vendido);
  const vendidos    = seriales.filter((s) =>  s.vendido)
    .sort((a, b) => new Date(b.fecha_salida) - new Date(a.fecha_salida));

  // Columnas: Cliente Origen ahora tiene Cédula Origen y Celular Origen al lado
  const COLS = [
    'IMEI', 'Estado', 'Marca', 'Modelo',
    'Cliente Origen', 'Cédula Origen', 'Celular Origen',
    'Fecha Entrada', 'Fecha Salida',
    'Cliente Venta', 'Cédula Cliente', 'Celular Cliente',
  ];
  const COL_WIDTHS = [22, 12, 14, 14, 22, 16, 16, 14, 14, 24, 16, 16];

  let fila = 2;

  // ── Helper interno para escribir una sección ──────────────────────────────
  // mostrarHistorial: si true, agrega sub-filas con ventas anteriores del IMEI
  // esVendido: true cuando la última entrada de historial_ventas ya está en la fila principal
  const escribirSeccion = (lista, titulo, colorTitulo, colorHeader, bgColor, estadoLabel, mostrarVacio, mostrarHistorial = false, esVendido = false) => {
    ws[XLSX.utils.encode_cell({ r: fila, c: 0 })] = {
      t: 's', v: titulo,
      s: { font: { bold: true, name: 'Arial', sz: 10, color: { rgb: colorTitulo } } },
    };
    fila++;

    COLS.forEach((col, c) => {
      ws[XLSX.utils.encode_cell({ r: fila, c })] = { t: 's', v: col, s: estiloHeader(colorHeader) };
    });
    fila++;

    if (lista.length === 0 && mostrarVacio) {
      ws[XLSX.utils.encode_cell({ r: fila, c: 0 })] = {
        t: 's', v: `Sin unidades ${estadoLabel}`, s: estiloCelda('F3F4F6'),
      };
      fila++;
      return;
    }

    lista.forEach((s) => {
      const vals = [
        s.imei,
        estadoLabel.charAt(0).toUpperCase() + estadoLabel.slice(1),
        s.marca                   || '',
        s.modelo                  || '',
        s.cliente_origen          || '',
        s.cedula_cliente_origen   || '',
        s.celular_cliente_origen  || '',
        fmtFecha(s.fecha_entrada),
        fmtFecha(s.fecha_salida),
        s.cliente_venta           || '',
        s.cedula_cliente_venta    || '',
        s.celular_cliente_venta   || '',
      ];
      vals.forEach((v, c) => {
        ws[XLSX.utils.encode_cell({ r: fila, c })] = {
          t: 's', v: String(v), s: estiloCelda(bgColor),
        };
      });
      fila++;

      // Sub-filas de ventas anteriores para trazabilidad
      if (mostrarHistorial) {
        const historial = Array.isArray(s.historial_ventas) ? s.historial_ventas : [];
        // Si el item está vendido, la última entrada del historial ES la venta actual (ya mostrada arriba)
        const previas = esVendido ? historial.slice(0, -1) : historial;
        previas.forEach((h) => {
          const histVals = [
            `↩ ${s.imei}`,
            'Venta anterior',
            s.marca  || '',
            s.modelo || '',
            '',
            '',
            '',
            '',
            fmtFecha(h.fecha),
            h.cliente || '',
            h.cedula  || '',
            h.celular || '',
          ];
          histVals.forEach((v, c) => {
            ws[XLSX.utils.encode_cell({ r: fila, c })] = {
              t: 's', v: String(v), s: estiloCeldaHistorial(),
            };
          });
          fila++;
        });
      }
    });
  };

  // ── Disponibles ───────────────────────────────────────────────────────────
  escribirSeccion(
    disponibles,
    `✓ DISPONIBLES (${disponibles.length})`,
    '065F46', COLOR.headerSerial, COLOR.disponible,
    'disponible', true, true, false,
  );
  ws[XLSX.utils.encode_cell({ r: fila, c: 0 })] = {
    t: 's', v: `Total disponibles: ${disponibles.length}`, s: estiloResumen(),
  };
  fila += 2;

  // ── Prestados ─────────────────────────────────────────────────────────────
  if (prestados.length > 0) {
    escribirSeccion(
      prestados,
      `⚠ PRESTADOS (${prestados.length})`,
      '92400E', 'B45309', COLOR.prestado,
      'prestado', false, true, false,
    );
    fila++;
  }

  // ── Vendidos ──────────────────────────────────────────────────────────────
  escribirSeccion(
    vendidos,
    `✗ VENDIDOS (${vendidos.length}) — ordenados por fecha de venta`,
    '991B1B', '991B1B', COLOR.vendido,
    'vendido', true, true, true,
  );

  ws['!ref']  = XLSX.utils.encode_range({ r: 0, c: 0 }, { r: fila, c: COLS.length - 1 });
  ws['!cols'] = COL_WIDTHS.map((w) => ({ wch: w }));
  ws['!rows'] = [{ hpt: 22 }];

  return ws;
}

// ─── Hoja de productos por cantidad ──────────────────────────────────────────

// Escribe una celda numérica o de texto con estilo, evitando repetición
function _cel(ws, r, c, v, s) {
  const esNum = typeof v === 'number';
  ws[XLSX.utils.encode_cell({ r, c })] = { t: esNum ? 'n' : 's', v: esNum ? v : String(v ?? ''), s };
}

function crearHojaCantidad(productos) {
  const ws = {};

  ws['A1'] = {
    t: 's', v: 'INVENTARIO — PRODUCTOS POR CANTIDAD',
    s: {
      font:      { bold: true, name: 'Arial', sz: 13, color: { rgb: COLOR.headerCantidad } },
      alignment: { horizontal: 'left', vertical: 'center' },
    },
  };

  // Detectar si algún producto tiene atributos/variantes para elegir el layout
  const tieneVariantes = productos.some((p) => p.atributos?.length > 0);

  const COLS = tieneVariantes
    ? ['Producto', 'Atributo', 'Sub-variante', 'Stock', 'Stock Mín', 'Unidad', 'Estado Stock', 'Cliente Origen', 'Fecha Registro']
    : ['Producto', 'Stock Actual', 'Stock Mínimo', 'Unidad', 'Estado Stock', 'Cliente Origen', 'Fecha Registro'];

  const COL_WIDTHS = tieneVariantes
    ? [28, 22, 22, 11, 11, 12, 14, 22, 16]
    : [28, 14, 14, 12, 15, 22, 16];

  // Índices de columna según modo
  // Sin variantes: Producto=0 Stock=1 StockMin=2 Unidad=3 Estado=4 Cliente=5 Fecha=6
  // Con variantes: Producto=0 Atrib=1 SubVar=2 Stock=3 StockMin=4 Unidad=5 Estado=6 Cliente=7 Fecha=8
  const IDX = tieneVariantes
    ? { stock: 3, stockMin: 4, unidad: 5, estado: 6, cliente: 7, fecha: 8 }
    : { stock: 1, stockMin: 2, unidad: 3, estado: 4, cliente: 5, fecha: 6 };

  let fila = 2;
  COLS.forEach((col, c) => {
    ws[XLSX.utils.encode_cell({ r: fila, c })] = { t: 's', v: col, s: estiloHeader(COLOR.headerCantidad) };
  });
  fila++;

  let totalStockGeneral = 0;

  const estadoLabel = (stock, stockMin, activo) => {
    if (!activo) return 'Inactivo';
    return stock <= stockMin ? 'Stock bajo' : 'OK';
  };
  const bgColor = (stock, stockMin, activo) => {
    if (!activo) return 'F3F4F6';
    return stock <= stockMin ? 'FEF3C7' : COLOR.disponible;
  };

  productos.forEach((p) => {
    const bg     = bgColor(p.stock, p.stock_minimo, p.activo);
    const estado = estadoLabel(p.stock, p.stock_minimo, p.activo);
    totalStockGeneral += Number(p.stock || 0);

    if (!tieneVariantes) {
      // ── Layout original ──────────────────────────────────────────────────
      const vals = [
        p.nombre, p.stock, p.stock_minimo,
        p.unidad_medida || 'unidad',
        estado, p.cliente_origen || '', fmtFecha(p.creado_en),
      ];
      vals.forEach((v, c) => {
        ws[XLSX.utils.encode_cell({ r: fila, c })] = {
          t: typeof v === 'number' ? 'n' : 's',
          v: typeof v === 'number' ? v : String(v),
          s: c === IDX.estado ? estiloCeldaCentrada(bg) : estiloCelda(bg),
        };
      });
      fila++;
      return;
    }

    // ── Layout con variantes ─────────────────────────────────────────────

    // Fila del producto (resumen total)
    _cel(ws, fila, 0, p.nombre, estiloCelda(bg));
    _cel(ws, fila, 1, '',       estiloCelda(bg));
    _cel(ws, fila, 2, '',       estiloCelda(bg));
    _cel(ws, fila, IDX.stock,    p.stock,                      estiloCelda(bg));
    _cel(ws, fila, IDX.stockMin, p.stock_minimo,                estiloCelda(bg));
    _cel(ws, fila, IDX.unidad,   p.unidad_medida || 'unidad',   estiloCelda(bg));
    _cel(ws, fila, IDX.estado,   estado,                       estiloCeldaCentrada(bg));
    _cel(ws, fila, IDX.cliente,  p.cliente_origen || '',        estiloCelda(bg));
    _cel(ws, fila, IDX.fecha,    fmtFecha(p.creado_en),        estiloCelda(bg));
    fila++;

    // Filas de atributos y sub-variantes
    (p.atributos || []).forEach((a) => {
      const etiqA  = a.tipo_nombre ? `${a.tipo_nombre}: ${a.valor}` : a.valor;
      const bgA    = bgColor(a.stock, a.stock_minimo, true);
      const estA   = estadoLabel(a.stock, a.stock_minimo, true);

      // Atributo
      _cel(ws, fila, 0, '',    estiloCelda(bgA));
      _cel(ws, fila, 1, etiqA, estiloCelda(bgA));
      _cel(ws, fila, 2, '',    estiloCelda(bgA));
      _cel(ws, fila, IDX.stock,    a.stock,     estiloCelda(bgA));
      _cel(ws, fila, IDX.stockMin, a.stock_minimo, estiloCelda(bgA));
      _cel(ws, fila, IDX.unidad,   '',          estiloCelda(bgA));
      _cel(ws, fila, IDX.estado,   estA,        estiloCeldaCentrada(bgA));
      _cel(ws, fila, IDX.cliente,  '',          estiloCelda(bgA));
      _cel(ws, fila, IDX.fecha,    '',          estiloCelda(bgA));
      fila++;

      // Sub-variantes
      (a.variantes || []).forEach((v) => {
        const etiqV = v.tipo_nombre ? `${v.tipo_nombre}: ${v.valor}` : v.valor;
        const bgV   = bgColor(v.stock, v.stock_minimo, true);
        const estV  = estadoLabel(v.stock, v.stock_minimo, true);

        _cel(ws, fila, 0, '',    estiloCelda(bgV));
        _cel(ws, fila, 1, '',    estiloCelda(bgV));
        _cel(ws, fila, 2, etiqV, estiloCelda(bgV));
        _cel(ws, fila, IDX.stock,    v.stock,          estiloCelda(bgV));
        _cel(ws, fila, IDX.stockMin, v.stock_minimo,   estiloCelda(bgV));
        _cel(ws, fila, IDX.unidad,   '',               estiloCelda(bgV));
        _cel(ws, fila, IDX.estado,   estV,             estiloCeldaCentrada(bgV));
        _cel(ws, fila, IDX.cliente,  '',               estiloCelda(bgV));
        _cel(ws, fila, IDX.fecha,    '',               estiloCelda(bgV));
        fila++;
      });
    });
  });

  // Fila resumen
  const colStock = tieneVariantes ? IDX.stock : 1;
  ws[XLSX.utils.encode_cell({ r: fila, c: 0 })] = { t: 's', v: `Total productos: ${productos.length}`, s: estiloResumen() };
  ws[XLSX.utils.encode_cell({ r: fila, c: colStock })] = { t: 'n', v: totalStockGeneral, s: estiloResumen() };
  for (let c = 1; c < COLS.length; c++) {
    if (c === colStock) continue;
    ws[XLSX.utils.encode_cell({ r: fila, c })] = { t: 's', v: '', s: estiloResumen() };
  }

  ws['!ref']  = XLSX.utils.encode_range({ r: 0, c: 0 }, { r: fila, c: COLS.length - 1 });
  ws['!cols'] = COL_WIDTHS.map((w) => ({ wch: w }));
  ws['!rows'] = [{ hpt: 22 }];

  return ws;
}

// ─── Función principal exportar ───────────────────────────────────────────────
export function exportarInventarioExcel(porProducto, cantidad) {
  const wb = XLSX.utils.book_new();

  Object.entries(porProducto).forEach(([nombre, seriales]) => {
    const nombreHoja = nombre
      .replace(/[:\\/?*[\]]/g, '')
      .substring(0, 31);
    const ws = crearHojaSerial(nombre, seriales);
    XLSX.utils.book_append_sheet(wb, ws, nombreHoja);
  });

  if (cantidad && cantidad.length > 0) {
    const ws = crearHojaCantidad(cantidad);
    XLSX.utils.book_append_sheet(wb, ws, 'Cantidades');
  }

  const hoy  = new Date();
  const ddmm = `${String(hoy.getDate()).padStart(2,'0')}-${String(hoy.getMonth()+1).padStart(2,'0')}-${hoy.getFullYear()}`;

  XLSX.writeFile(wb, `inventario_${ddmm}.xlsx`, { bookType: 'xlsx', bookSST: false });
}