DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

PORT=
NODE_ENV=
FRONTEND_URL=

# ── Backups (opcionales — el sistema funciona sin ellas) ────────────────
# Proyecto Supabase donde se guardan los backups (distinto al de la BD)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Email que recibe alertas cuando un backup falla o luce sospechoso
BACKUP_ALERT_EMAIL=
# URL de healthchecks.io — avisa si el backup deja de ejecutarse
BACKUP_HEALTHCHECK_URL=
# Frecuencia del backup JSON (default: "0 2 * * *" — 2:00 AM Bogotá)
# Ej. cada 6 horas: "0 */6 * * *"
BACKUP_CRON=

# ── Notificaciones push (Web Push / VAPID) ──────────────────────────────
# Par de claves propio de cada entorno. Se generan una sola vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# OJO: si se cambian, TODAS las suscripciones existentes dejan de servir y los
# usuarios tienen que volver a activar las notificaciones en su dispositivo.
# Sin estas variables el módulo no se monta y la app funciona igual, sin avisos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que exige el estándar (mailto: o https://). Lo usan los navegadores
# para avisarte si tus envíos dan problemas.
VAPID_SUBJECT=mailto:tucorreo@ejemplo.com
# Cuándo salen los avisos diarios (cartera vencida, plan por vencer, stock bajo).
# Por defecto "0 8 * * *" — 8:00 AM hora de Colombia.
NOTIF_CRON=
