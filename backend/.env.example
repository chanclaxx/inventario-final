DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

PORT=
NODE_ENV=
FRONTEND_URL=

# ── Backups (opcionales — el sistema funciona sin ellas) ────────────────
# Proyecto Supabase donde se guardan los backups (distinto al de la BD)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Email que recibe alertas cuando un backup falla o luce sospechoso
BACKUP_ALERT_EMAIL=
# URL de healthchecks.io — avisa si el backup deja de ejecutarse
BACKUP_HEALTHCHECK_URL=
# Frecuencia del backup JSON (default: "0 2 * * *" — 2:00 AM Bogotá)
# Ej. cada 6 horas: "0 */6 * * *"
BACKUP_CRON=
